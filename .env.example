# =============================================================================
#  Jowain Yanbu Est. — environment
# =============================================================================
#  Copy to `.env.local` for development, or enter these in the hosting
#  platform's environment panel for production.
#
#  NEVER commit a filled-in copy. `.gitignore` already excludes `.env`,
#  `.env.local` and every `.env.*.local`.
#
#  Only RESEND_API_KEY is secret. The other three are public values that simply
#  need to be correct.
# =============================================================================


# -----------------------------------------------------------------------------
#  Canonical site origin  —  REQUIRED in production
# -----------------------------------------------------------------------------
#  One variable controls every absolute URL the site emits: canonical tags,
#  hreflang alternates, Open Graph and Twitter URLs, sitemap.xml, robots.txt
#  and every JSON-LD @id.
#
#  Use the exact canonical host, with protocol and NO trailing slash. Pick one
#  of www / non-www and stay on it — the other must 301 to it, or the two get
#  indexed as separate sites.
#
#  If unset, the code falls back to https://jowainyanbu.com (the domain
#  currently live on Hostinger). A bare hostname or a trailing slash is
#  tolerated and normalised.
SITE_URL=https://jowainyanbu.com

#  Optional alias, accepted because some platforms nudge toward the
#  NEXT_PUBLIC_ prefix. SITE_URL wins if both are set. Not a secret.
# NEXT_PUBLIC_SITE_URL=https://jowainyanbu.com


# -----------------------------------------------------------------------------
#  Enquiry delivery  —  REQUIRED, or contact and quote forms return 503
# -----------------------------------------------------------------------------
#  All three must be present for /api/contact and /api/quote to send. If any is
#  missing the endpoint returns 503 and the form shows its email fallback — it
#  deliberately does NOT report a false success.

#  Resend API key — https://resend.com → API Keys. Sending permission only.
#  SECRET. Never expose client-side; never commit.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

#  From address. MUST be on a domain verified in Resend (Domains → Add Domain,
#  then add the DKIM/SPF records it gives you at your DNS host). It is never the
#  customer's address — that would fail SPF/DKIM and land in spam. The
#  customer's address goes in Reply-To automatically.
EMAIL_FROM=Jowain Yanbu Est. <noreply@jowainyanbu.com>

#  Where enquiries are delivered. Comma-separate for more than one recipient.
ENQUIRY_TO_EMAIL=contact@jowainyanbu.com


# -----------------------------------------------------------------------------
#  Runtime
# -----------------------------------------------------------------------------
#  Set by the platform in most cases. Set it explicitly when running the
#  standalone server by hand.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# Search Console ownership tokens. Optional; the meta tag is not rendered
# until set. Baked into prerendered HTML, so set at BUILD time and redeploy.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
